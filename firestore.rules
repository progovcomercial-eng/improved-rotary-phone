rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.email == 'progovcomercial@gmail.com'; }
    function staff() {
      return signedIn() && (
        owner() ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true)
      );
    }
    function manager() {
      return owner() ||
        (staff() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['gerente']);
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update: if signedIn() && request.auth.uid == uid || owner();
      allow delete: if owner();
    }
    match /staff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || owner());
      allow create, update, delete: if owner();
    }
    match /{collectionName}/{documentId} {
      allow read: if collectionName in ['plans','treatments','partners','products','promotions'] && resource.data.active == true;
      allow read: if staff();
      allow create, update, delete: if manager() && collectionName in ['customers','members','plans','treatments','partners','products','promotions','appointments','orders','settings','staff'];
    }
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name','contact','request','status','createdAt']);
      allow read, update, delete: if staff();
    }
  }
}